[Unit]
Description=Ical aggregator service
Documentation=https://github.com/a-schild/ical-aggregator
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/ical-aggregator/server.js
WorkingDirectory=/opt/ical-aggregator
# Restart service after 10 seconds if node service crashes
RestartSec=10
Restart=always
# Own system user without login shell, created by scripts/update.sh:
#   useradd --system --user-group --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin ical-aggregator
User=ical-aggregator
Group=ical-aggregator
Environment=PATH=/usr/bin:/usr/local/bin
Environment=NODE_ENV=production

# Hardening: the web service only reads its install dir and talks to the network
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
